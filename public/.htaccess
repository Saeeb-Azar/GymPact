# Hostinger (Apache/LiteSpeed) – SPA-Fallback + Basis-Header.
# Ohne dies liefert ein Reload auf z. B. /progress einen 404,
# da React Router die Route nur clientseitig kennt.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Echte Dateien/Ordner (Assets, Icons, manifest.webmanifest, sw.js) direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alles andere auf die SPA-Shell umleiten
  RewriteRule ^ index.html [L]
</IfModule>

# Service Worker niemals cachen, sonst bekommen Nutzer Updates nicht mit
<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "^manifest\.webmanifest$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Gehashte Assets (index-xxxx.js/css) dürfen lange gecacht werden
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# HTTPS erzwingen (Push/Service Worker funktionieren nur über HTTPS)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
