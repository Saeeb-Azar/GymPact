# Supabase-Projekt (Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID Public Key für Web Push (siehe README → "Web Push einrichten")
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---------------------------------------------------------------
# Die folgenden Variablen gehören NICHT ins Frontend!
# Sie werden als Secrets der Supabase Edge Functions gesetzt:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
#   supabase secrets set RESEND_API_KEY=...   # optional, für E-Mail-Fallback
#   supabase secrets set EMAIL_FROM="GymPact <noreply@example.com>"
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase in Edge
# Functions automatisch bereit.
# ---------------------------------------------------------------
